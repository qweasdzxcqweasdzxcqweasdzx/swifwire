{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftun.com/schema/inbound.v1.json",
  "title": "SwifWire panel inbound (3x-ui sidecar style)",
  "type": "object",
  "required": ["protocol", "port", "settings"],
  "properties": {
    "protocol": { "const": "swifwire" },
    "listen": { "type": "string", "default": "0.0.0.0" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "tag": { "type": "string" },
    "remark": { "type": "string" },
    "settings": {
      "type": "object",
      "required": ["static_key_path"],
      "properties": {
        "static_key_path": { "type": "string", "description": "32-byte server secret file" },
        "pub_out_path": { "type": "string", "default": "server.pub" },
        "mask": {
          "type": "string",
          "enum": ["null_tcp", "tls13_stable", "quic_fast"],
          "default": "tls13_stable"
        },
        "sni": { "type": "string", "default": "cover.local" },
        "cover": { "type": "string", "description": "optional HTTP cover upstream host:port" },
        "egress": {
          "type": "string",
          "description": "direct | socks5://127.0.0.1:PORT (Xray bridge)",
          "default": "direct"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["email", "enable"],
            "properties": {
              "email": { "type": "string" },
              "enable": { "type": "boolean" },
              "limit_ip": { "type": "integer" },
              "total_gb": { "type": "number" },
              "expiry_time": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}

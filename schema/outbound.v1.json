{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftun.com/schema/outbound.v1.json",
  "title": "SwifWire client outbound (VPN / embed)",
  "type": "object",
  "required": ["protocol", "settings"],
  "properties": {
    "protocol": { "const": "swifwire" },
    "tag": { "type": "string" },
    "settings": {
      "type": "object",
      "required": ["address", "port", "server_pub_hex"],
      "properties": {
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "server_pub_hex": { "type": "string", "minLength": 64, "maxLength": 64 },
        "mask": {
          "type": "string",
          "enum": ["null_tcp", "tls13_stable", "quic_fast"],
          "default": "tls13_stable"
        },
        "sni": { "type": "string" },
        "socks_listen": { "type": "string", "default": "127.0.0.1:10808" },
        "pack_url": { "type": "string" },
        "pack_trust_pub_hex": { "type": "string" }
      }
    }
  }
}
